# AGREGA ESTAS VARIABLES A TU front-astro/.env EXISTENTE (sin borrar Google Auth)
MP_ACCESS_TOKEN=TU_ACCESS_TOKEN_DE_PRUEBA
# Copia la clave compartida que pusiste en back/.env
BETONOS_INTERNAL_KEY=CAMBIAR_POR_CLAVE_ALEATORIA
# La clave secreta se obtiene en Mercado Pago Developers > Webhooks
MP_WEBHOOK_SECRET=TU_SECRETO_DE_WEBHOOK
# HTTPS real (Netlify o un túnel público). En local, déjalo vacío.
SITE_URL=
# Debe seguir apuntando al backend GraphQL; no reemplaces esta variable si ya la tienes.
PUBLIC_API_URL=http://localhost:4000/graphql
