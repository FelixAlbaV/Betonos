# Copia este archivo a .env y completa los valores.

# Credenciales OAuth2 de Google (Google Cloud Console > Credentials > OAuth client ID).
# Redirect URI autorizada para desarrollo: http://localhost:4321/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Clave para firmar/encriptar la sesión (JWT). Generar con: openssl rand -hex 32
AUTH_SECRET=
AUTH_TRUST_HOST=true

# URL del backend GraphQL (Apollo Server, ver carpeta back/). Debe llevar el
# prefijo PUBLIC_ porque esta variable se usa también en el navegador.
PUBLIC_API_URL=http://localhost:4000/graphql
