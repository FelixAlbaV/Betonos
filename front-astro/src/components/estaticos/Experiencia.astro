---
const RAZONES = [
  {
    icono: '🎧',
    titulo: 'Equipo especializado',
    texto: 'Modelos pensados para gamers, músicos y uso diario, según tu estilo de vida.',
  },
  {
    icono: '🔎',
    titulo: 'Elige con claridad',
    texto: 'Consulta precio, disponibilidad y características antes de agregar algo al carrito.',
  },
  {
    icono: '📦',
    titulo: 'Compra directa',
    texto: 'Compra directamente con Betonos, sin depender de plataformas externas.',
  },
]
---
<section class="seccion">
  <div class="encabezado">
    <span class="etiqueta">EXPERIENCIA BETONOS</span>
    <h2 class="titulo">Más que comprar equipo</h2>
    <p class="texto">
      Una experiencia directa con la marca, pensada para ayudarte a elegir el equipo ideal
      para tu entrenamiento.
    </p>
  </div>

  <div class="grid">
    {RAZONES.map((razon) => (
      <div class="tarjeta">
        <h3>{razon.icono} {razon.titulo}</h3>
        <p>{razon.texto}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .seccion {
    margin: 28px 0;
  }

  .encabezado {
    max-width: 520px;
    margin-bottom: 20px;
  }

  .etiqueta {
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--color-oro);
    font-weight: 600;
  }

  .titulo {
    font-size: 32px;
    margin-top: 8px;
  }

  .texto {
    margin-top: 10px;
    color: var(--color-texto-tenue);
    font-size: 15px;
    line-height: 1.5;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
    gap: 16px;
  }

  .tarjeta {
    background: var(--color-superficie);
    border: 1px solid var(--color-borde);
    border-radius: var(--radio);
    padding: 20px 18px;
  }

  .tarjeta h3 {
    font-family: var(--fuente-texto);
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .tarjeta p {
    font-size: 13px;
    color: var(--color-texto-tenue);
    margin: 0;
    line-height: 1.5;
  }
</style>
